; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="I Hate My Job"
run/main_scene="uid://d24jubegvm4ly"
config/features=PackedStringArray("4.5")
config/icon="uid://bjv6sibxm861c"

[autoload]

TimeManager="*res://Scripts/time_manager.gd"
GameManager="*res://Scripts/game_manager.gd"
EventManager="*res://Scripts/event_manager.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
PlayerManager="*res://Scripts/playerManager.gd"

[dialogic]

directories/dch_directory={
"test_char": "res://DialoguePlugin/CHARACTERS/test_char.dch"
}
directories/dtl_directory={
"test": "res://DialoguePlugin/TIMELINE/test.dtl"
}
layout/style_directory={
"": "res://DialoguePlugin/STYLE/test_style.tres",
"test_style": "res://DialoguePlugin/STYLE/test_style.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://DialoguePlugin/STYLE/test_style.tres"]
layout/default_style="res://DialoguePlugin/STYLE/test_style.tres"
variables={
"Test_var": "hola"
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
translation/enabled=true
translation/file_mode=1
translation/translation_folder="res://Textfiles/DialogicTranslations"
translation/save_mode=0
translation/add_separator=false
translation/id_counter=19
translation/intern/save_mode=0
translation/intern/file_mode=1
translation/intern/translation_folder="res://Textfiles/DialogicTranslations"
translation/original_locale="es"
translation/locales=["en"]

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[editor]

run/main_run_args="click"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://DialoguePlugin/": "yellow",
"res://Prefabs/": "green",
"res://Resources/": "teal",
"res://Scenes/": "blue",
"res://Scripts/": "purple",
"res://Textfiles/": "pink",
"res://addons/": "red"
}

[global_group]

Interactable="Nodos de interacción con el jugador"
Player=""
Interactor=""

