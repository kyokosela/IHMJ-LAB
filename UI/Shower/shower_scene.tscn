[sub_resource type="Shader" id="Shader_silhouette"]
code = "shader_type canvas_item;
// Silueta lisa: solo la forma del dibujo (COLOR.a ya trae la transparencia del dibujo y el fundido).
uniform vec4 tint : source_color = vec4(0.09, 0.12, 0.2, 0.9);
void fragment() {
	COLOR = vec4(tint.rgb, COLOR.a * tint.a);
}
"

