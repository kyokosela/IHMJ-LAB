[sub_resource type="Resource" id="Resource_hot_modifier"]
script = ExtResource("5_modifier")
applies_to = "hot"
metadata/_custom_type_script = "uid://wotj3baput20"

[sub_resource type="Resource" id="Resource_fresh_modifier"]
script = ExtResource("5_modifier")
applies_to = "fresh"
multiplier = 0.0
metadata/_custom_type_script = "uid://wotj3baput20"

[sub_resource type="Resource" id="Resource_coldness"]
script = ExtResource("2_condition")
condition = "coldness"
value = 50.0
enviroment_condition = "temperature"
modifiers = Array[ExtResource("5_modifier")]([SubResource("Resource_cold_modifier"), SubResource("Resource_hot_modifier"), SubResource("Resource_fresh_modifier")])
condition_threshold = SubResource("Resource_coldness_threshold")
can_decay = true
metadata/_custom_type_script = "uid://dbp4u6dyakclb"

[resource]
script = ExtResource("9_itemdata")
item_name = "_COFFEE_"
item_unique_name = "coffee"
item_type = 1
behavior = SubResource("Resource_behavior")
consume_after_use = true
custom_conditions = Array[ExtResource("2_condition")]([SubResource("Resource_coldness")])
metadata/_custom_type_script = "uid://b03xnf82gb26a"
